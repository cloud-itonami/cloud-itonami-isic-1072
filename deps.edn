{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout -- a standalone fork should override
 ;; them with git coordinates (see "Standalone Use" in README.md).
 :deps {
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "0ffd5f6340af50871d4759b06e02ac4fbf9a4bdf"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       ;; jp-go-digital-design-system (DADS): the workspace's BASE design
        ;; system. Consumed as a git dep (NOT :local/root) so a standalone
        ;; fork resolves it too; `sugarops.render-html` inlines
        ;; `jp-go-dds.skin/dds+skin` into docs/samples/operator-console.html.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        ;; langchain-store: the shared langchain.db store seam (EDN-blob
        ;; codec + identity schema + event-log read/append helpers) that
        ;; ~190 cloud-itonami actors hand-roll (ADR-2607141600);
        ;; sugarops.store's DatomicStore uses it instead of its own
        ;; enc/dec* two-liner.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  :run {:main-opts ["-m" "sugarops.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by RUNNING the real actor
  ;; (advisor -> governor -> store) -- no hand-written page content.
  :render-html {:main-opts ["-m" "sugarops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
